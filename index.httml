<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#070a0f">
<title>OXIDE:DROPS</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

body{
  background:radial-gradient(circle at 50% -10%,#202d3d,#070a0f 45%);
  color:#fff;
  font-family:Arial,sans-serif;
  min-height:100vh
}

button{font:inherit;cursor:pointer}
button:disabled{opacity:.45;cursor:not-allowed}

.app{
  width:min(100%,480px);
  min-height:100vh;
  margin:auto;
  padding-bottom:90px
}

header{
  height:70px;
  padding:14px 16px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  position:sticky;
  top:0;
  z-index:20;
  background:rgba(7,10,15,.92);
  backdrop-filter:blur(15px)
}

.logo{
  display:flex;
  align-items:center;
  gap:9px;
  font-size:21px;
  font-weight:1000
}

.logo img{
  width:42px;
  height:42px;
  border-radius:10px;
  object-fit:cover
}

.balance{
  background:#151d28;
  border:1px solid #293443;
  border-radius:14px;
  padding:9px 12px;
  color:#ffd84d;
  font-weight:900
}

.page{padding:0 15px}
.hidden{display:none!important}

.title{
  font-size:21px;
  font-weight:900;
  margin:24px 0 12px
}

/* =========================
   БАННЕР
========================= */

.hero{
  position:relative;
  overflow:hidden;
  margin-top:12px;
  padding:22px;
  min-height:190px;
  border:1px solid #344354;
  border-radius:25px;
  background:
    radial-gradient(circle at 90% 20%,rgba(255,216,77,.18),transparent 30%),
    linear-gradient(135deg,#1d2c3d,#0d131b)
}

.hero::before{
  content:"";
  position:absolute;
  width:180px;
  height:180px;
  right:-70px;
  top:-70px;
  border-radius:50%;
  border:25px solid rgba(255,255,255,.025)
}

.hero-logo{
  width:58px;
  height:58px;
  border-radius:15px;
  object-fit:cover;
  border:1px solid #465568;
  box-shadow:0 0 30px rgba(255,216,77,.15);
  margin-bottom:10px
}

.hero small{
  color:#ffd84d;
  font-weight:900
}

.hero h1{
  font-size:28px;
  margin:7px 0
}

.hero p{
  color:#9aa6b5;
  line-height:1.45;
  max-width:330px
}

/* =========================
   КЕЙСЫ
========================= */

.cases{
  display:grid;
  gap:12px
}

.case{
  display:flex;
  align-items:center;
  gap:13px;
  padding:14px;
  border:1px solid #263140;
  background:#111720;
  border-radius:19px;
  transition:.2s
}

.case:active{transform:scale(.98)}

.case-icon{
  width:68px;
  height:68px;
  border-radius:17px;
  background:#202a37;
  display:grid;
  place-items:center;
  font-size:34px;
  flex-shrink:0
}

.case-info{flex:1}

.case-name{
  font-weight:900;
  font-size:16px
}

.case-price{
  margin-top:6px;
  color:#ffd84d;
  font-weight:800
}

.open{
  border:0;
  background:#fff;
  color:#080a0e;
  border-radius:12px;
  padding:11px 13px;
  font-weight:900
}

/* =========================
   CARD
========================= */

.card{
  background:#111720;
  border:1px solid #263140;
  border-radius:20px;
  padding:17px
}

/* =========================
   РУЛЕТКА
========================= */

.case-modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.82);
  display:none;
  align-items:center;
  justify-content:center;
  z-index:100
}

.case-modal.show{display:flex}

.case-window{
  width:min(470px,94%);
  background:#10161e;
  border:1px solid #303c4c;
  border-radius:24px;
  padding:18px 12px 22px;
  overflow:hidden;
  box-shadow:0 25px 80px rgba(0,0,0,.65)
}

.case-window h2{
  text-align:center;
  margin-bottom:17px
}

.roulette{
  position:relative;
  width:100%;
  height:132px;
  overflow:hidden;
  border-radius:17px;
  background:#090d13;
  border:1px solid #27313e
}

.roulette::before{
  content:"";
  position:absolute;
  top:0;
  bottom:0;
  left:50%;
  width:2px;
  background:#fff;
  box-shadow:0 0 14px rgba(255,255,255,.8);
  z-index:20
}

.pointer{
  position:absolute;
  top:-1px;
  left:50%;
  transform:translateX(-50%);
  z-index:30;
  width:0;
  height:0;
  border-left:11px solid transparent;
  border-right:11px solid transparent;
  border-top:23px solid #ffd84d
}

.roulette-track{
  height:100%;
  display:flex;
  align-items:center;
  gap:9px;
  padding-left:50%;
  will-change:transform
}

.roulette-item{
  flex:0 0 94px;
  height:102px;
  border-radius:14px;
  border:1px solid #303b49;
  background:#1b2430;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:8px
}

.roulette-item .icon{
  width:53px;
  height:53px;
  border-radius:11px;
  background:#283341;
  display:grid;
  place-items:center;
  font-size:29px
}

.roulette-item span{
  font-size:10px;
  color:#9ba6b5;
  text-align:center
}

.result{
  text-align:center;
  margin-top:17px;
  min-height:25px;
  font-size:18px;
  font-weight:900
}

.close-case{
  width:100%;
  margin-top:14px;
  border:0;
  border-radius:13px;
  padding:13px;
  background:#fff;
  font-weight:1000
}

/* =========================
   ИНВЕНТАРЬ
========================= */

.inventory-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:7px
}

.item{
  min-width:0;
  background:#111720;
  border:1px solid #263140;
  border-radius:13px;
  padding:6px
}

.item-img{
  height:76px;
  border-radius:9px;
  background:#202a36;
  display:grid;
  place-items:center;
  font-size:30px
}

.item-name{
  font-size:11px;
  font-weight:900;
  margin-top:7px;
  line-height:1.15
}

.item-price{
  font-size:11px;
  margin-top:4px;
  font-weight:900
}

.sell{
  width:100%;
  margin-top:6px;
  border:0;
  border-radius:8px;
  padding:7px 2px;
  background:#fff;
  color:#000;
  font-size:10px;
  font-weight:900
}

/* =========================
   РЕДКОСТИ
========================= */

.common{color:#bfc5cc}
.rare{color:#4d8dff}
.superrare{color:#46d8ff}
.epic{color:#b86cff}
.mythic{color:#ff4545}
.legendary{color:#ffd21f}

/* =========================
   UPGRADE
========================= */

.upgrade-layout{
  display:grid;
  gap:12px
}

.upgrade-item{
  background:#111720;
  border:1px solid #263140;
  border-radius:20px;
  padding:15px
}

.upgrade-image{
  height:150px;
  border-radius:15px;
  background:#202a36;
  display:grid;
  place-items:center;
  font-size:55px
}

.selected-name{
  margin-top:12px;
  font-size:18px;
  font-weight:1000
}

.select-skin{
  margin-top:11px;
  width:100%;
  padding:12px;
  border:1px solid #303c4b;
  background:#1a222d;
  color:#fff;
  border-radius:12px;
  font-weight:900
}

.selected-list{
  margin-top:10px;
  color:#8995a6;
  font-size:12px;
  line-height:1.5
}

.chances{
  display:grid;
  gap:8px;
  margin-top:12px
}

.chance{
  display:flex;
  justify-content:space-between;
  padding:13px;
  background:#0c1118;
  border:1px solid #293443;
  border-radius:13px;
  color:#fff
}

.chance.selected{border-color:#fff}

.green{color:#5ee68a}
.yellow{color:#ffd84d}
.red{color:#ff6464}

.wheel-wrap{
  position:relative;
  width:245px;
  margin:18px auto
}

.wheel{
  width:245px;
  height:245px;
  border-radius:50%;
  position:relative;
  display:grid;
  place-items:center;
  background:conic-gradient(#5ee68a 0 270deg,#252c36 270deg);
  box-shadow:0 0 45px rgba(255,216,77,.08)
}

.wheel::after{
  content:"";
  width:185px;
  height:185px;
  background:#0b1016;
  border-radius:50%;
  position:absolute
}

.wheel span{
  position:relative;
  z-index:2;
  font-size:27px;
  font-weight:1000
}

.wheel-arrow{
  position:absolute;
  top:-13px;
  left:50%;
  transform:translateX(-50%);
  z-index:10;
  width:0;
  height:0;
  border-left:12px solid transparent;
  border-right:12px solid transparent;
  border-top:27px solid #fff
}

.strength{
  text-align:center;
  color:#8995a6
}

.strength b{
  color:#fff;
  font-size:28px
}

.hold{
  width:100%;
  margin-top:13px;
  padding:17px;
  border:0;
  border-radius:15px;
  background:#fff;
  color:#000;
  font-weight:1000
}

.hold.active{background:#ffd84d}

.upgrade-cost{
  text-align:center;
  margin-top:10px;
  color:#ffd84d;
  font-weight:900
}

@keyframes wheelSpin{
  0%{transform:rotate(0deg)}
  20%{transform:rotate(180deg)}
  70%{transform:rotate(900deg)}
  90%{transform:rotate(1260deg)}
  100%{transform:rotate(1440deg)}
}

/* =========================
   ПРОФИЛЬ
========================= */

.profile-head{
  display:flex;
  align-items:center;
  gap:14px
}

.avatar{
  width:65px;
  height:65px;
  border-radius:50%;
  background:#222d3b;
  display:grid;
  place-items:center;
  font-size:27px;
  overflow:hidden;
  flex-shrink:0
}

.avatar img{
  width:100%;
  height:100%;
  object-fit:cover
}

.name{
  font-size:20px;
  font-weight:900
}

.rank{
  color:#ffd84d;
  margin-top:5px
}

.stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;
  margin-top:16px
}

.stat{
  background:#0c1118;
  border-radius:13px;
  padding:12px 5px;
  text-align:center
}

.stat b{
  display:block;
  font-size:18px
}

.stat span{
  font-size:11px;
  color:#8995a6
}

.progress{
  height:8px;
  background:#0b1016;
  border-radius:20px;
  overflow:hidden;
  margin-top:13px
}

.progress div{
  height:100%;
  width:0;
  background:linear-gradient(90deg,#ffd84d,#ff9d38);
  transition:.4s
}

/* =========================
   DAILY
========================= */

.reward-box{
  display:grid;
  grid-template-columns:repeat(7,1fr);
  gap:5px;
  margin-top:12px
}

.day{
  background:#0c1118;
  border:1px solid #263140;
  border-radius:10px;
  padding:9px 2px;
  text-align:center;
  font-size:10px
}

.day b{
  display:block;
  color:#ffd84d;
  margin-top:5px
}

.day.today{border-color:#ffd84d}
.day.claimed{opacity:.35}

.claim-daily{
  width:100%;
  margin-top:12px;
  border:0;
  border-radius:12px;
  padding:13px;
  background:#ffd84d;
  color:#000;
  font-weight:1000
}

/* =========================
   МАГАЗИН
========================= */

.store{
  display:grid;
  gap:11px
}

.pack{
  padding:18px;
  background:linear-gradient(135deg,#151e29,#0f141b);
  border:1px solid #263140;
  border-radius:19px;
  display:flex;
  align-items:center;
  justify-content:space-between
}

.pack-coins{
  font-size:21px;
  font-weight:1000
}

.pack-price{
  color:#ffd84d;
  margin-top:5px;
  font-weight:900
}

.buy{
  border:0;
  border-radius:12px;
  padding:11px 15px;
  background:#fff;
  color:#000;
  font-weight:1000
}

/* =========================
   SELECTOR
========================= */

.selector-modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.85);
  z-index:150;
  display:none;
  align-items:flex-end;
  justify-content:center
}

.selector-modal.show{display:flex}

.selector-window{
  width:min(480px,100%);
  max-height:85vh;
  overflow:auto;
  background:#10161e;
  border-radius:24px 24px 0 0;
  padding:18px
}

.selector-title{
  text-align:center;
  font-size:19px;
  font-weight:1000;
  margin-bottom:8px
}

.selector-info{
  color:#8995a6;
  text-align:center;
  font-size:12px;
  margin-bottom:14px
}

.selector-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:8px
}

.selector-item{
  background:#151d27;
  border:1px solid #2a3544;
  border-radius:14px;
  padding:10px;
  text-align:left
}

.selector-item.selected{
  border-color:#ffd84d;
  box-shadow:0 0 0 1px #ffd84d
}

.selector-item .big{
  font-size:30px
}

.selector-item b{
  display:block;
  font-size:12px;
  margin-top:5px
}

.selector-item small{
  color:#8995a6
}

.selector-close{
  width:100%;
  border:0;
  background:#fff;
  color:#000;
  border-radius:12px;
  padding:13px;
  margin-top:12px;
  font-weight:1000
}

/* =========================
   МЕНЮ
========================= */

.bottom{
  position:fixed;
  bottom:0;
  left:50%;
  transform:translateX(-50%);
  width:min(480px,100%);
  height:76px;
  background:rgba(13,18,25,.96);
  backdrop-filter:blur(18px);
  border-top:1px solid #28313d;
  display:grid;
  grid-template-columns:repeat(5,1fr);
  z-index:50
}

.bottom button{
  border:0;
  background:none;
  color:#788495;
  font-size:10px;
  font-weight:700
}

.bottom button span{
  font-size:21px;
  display:block;
  margin-bottom:3px
}

.bottom button.active{color:#fff}

.toast{
  position:fixed;
  left:50%;
  bottom:91px;
  transform:translateX(-50%) translateY(20px);
  background:#fff;
  color:#000;
  padding:12px 17px;
  border-radius:13px;
  font-weight:900;
  opacity:0;
  pointer-events:none;
  transition:.25s;
  z-index:200;
  max-width:90%;
  text-align:center
}

.toast.show{
  opacity:1;
  transform:translateX(-50%) translateY(0)
}
</style>
</head>

<body>

<div class="app">

<header>
  <div class="logo">
    <img src="avatar.png" alt="OXIDE:DROPS">
    <span>OXIDE:DROPS</span>
  </div>

  <div class="balance">
    🪙 <span id="coins">250</span>
  </div>
</header>


<!-- =========================
     ГЛАВНАЯ
========================= -->

<section id="home" class="page">

  <div class="hero">

    <img class="hero-logo" src="avatar.png" alt="OXIDE:DROPS">

    <small>⚡ OXIDE:DROPS</small>

    <h1>Открывай. Улучшай. Забирай.</h1>

    <p>
      Собирай редкие скины, открывай лучшие наборы
      и прокачивай свою коллекцию.
    </p>

  </div>


  <div class="title">🔥 Лучшие наборы</div>

  <div class="cases">

    <div class="case">
      <div class="case-icon">❄️</div>

      <div class="case-info">
        <div class="case-name">Морозный ужас</div>
        <div class="case-price">40 🪙</div>
      </div>

      <button class="open"
        onclick="openCase('Морозный ужас','❄️',40)">
        Открыть
      </button>
    </div>


    <div class="case">
      <div class="case-icon">🔥</div>

      <div class="case-info">
        <div class="case-name">Адское пламя</div>
        <div class="case-price">50 🪙</div>
      </div>

      <button class="open"
        onclick="openCase('Адское пламя','🔥',50)">
        Открыть
      </button>
    </div>


    <div class="case">
      <div class="case-icon">🤖</div>

      <div class="case-info">
        <div class="case-name">Эпоха современности</div>
        <div class="case-price">30 🪙</div>
      </div>

      <button class="open"
        onclick="openCase('Эпоха современности','🤖',30)">
        Открыть
      </button>
    </div>

  </div>


  <div class="title">🎁 Кейсы</div>

  <div class="cases">

    <div class="case">
      <div class="case-icon">🔫</div>

      <div class="case-info">
        <div class="case-name">Оружейный ящик</div>
        <div class="case-price">35 🪙</div>
      </div>

      <button class="open" onclick="openWeaponCase()">
        Открыть
      </button>
    </div>

  </div>

</section>


<!-- =========================
     ИНВЕНТАРЬ
========================= -->

<section id="inventory" class="page hidden">

  <div class="title">🎒 Инвентарь</div>

  <div id="inventoryGrid" class="inventory-grid"></div>

</section>


<!-- =========================
     UPGRADE
========================= -->

<section id="upgrade" class="page hidden">

  <div class="title">⬆️ Upgrade</div>

  <div class="upgrade-layout">

    <div class="upgrade-item">

      <div class="upgrade-image" id="upgradeIcon">
        ⬜
      </div>

      <div class="selected-name" id="upgradeName">
        Скины не выбраны
      </div>

      <div style="color:#ffd84d;margin-top:5px" id="upgradeValue">
        —
      </div>

      <div class="selected-list" id="selectedList">
        Можно выбрать до 3 скинов одной редкости.
      </div>

      <button class="select-skin" onclick="openSkinSelector()">
        🎒 Выбрать скины
      </button>

    </div>


    <div class="card">

      <div style="font-weight:900">
        Шанс улучшения
      </div>

      <div class="chances">

        <button class="chance selected"
          onclick="selectChance(75,this)">
          <span class="green">🟢 75%</span>
          <b class="green">+1 редкость</b>
        </button>

        <button class="chance"
          onclick="selectChance(50,this)">
          <span class="yellow">🟡 50%</span>
          <b class="yellow">+2 редкости</b>
        </button>

        <button class="chance"
          onclick="selectChance(33,this)">
          <span class="red">🔴 33%</span>
          <b class="red">+3 редкости</b>
        </button>

      </div>


      <div class="wheel-wrap">

        <div class="wheel-arrow"></div>

        <div class="wheel" id="wheel">
          <span id="wheelText">75%</span>
        </div>

      </div>


      <div class="strength">
        Сила прокрутки<br>
        <b id="strength">20</b> / 100
      </div>


      <div class="upgrade-cost">
        Стоимость попытки: 10 🪙
      </div>


      <button class="hold" id="holdButton">
        УДЕРЖИВАЙ ДЛЯ НАБОРА СИЛЫ
      </button>

    </div>

  </div>

</section>


<!-- =========================
     ПРОФИЛЬ
========================= -->

<section id="profile" class="page hidden">

  <div class="title">👤 Профиль</div>

  <div class="card">

    <div class="profile-head">

      <div class="avatar" id="avatar">
        <img src="avatar.png" alt="avatar">
      </div>

      <div>

        <div class="name" id="profileName">
          Игрок
        </div>

        <div class="rank" id="profileRank">
          Новобранец
        </div>

      </div>

    </div>


    <div class="progress">
      <div id="xpBar"></div>
    </div>


    <div style="margin-top:7px;color:#8995a6;font-size:12px"
      id="xpText">
      0 / 50 HP
    </div>


    <div class="stats">

      <div class="stat">
        <b id="statOpen">0</b>
        <span>Открытий</span>
      </div>

      <div class="stat">
        <b id="statUpgrade">0</b>
        <span>Апгрейдов</span>
      </div>

      <div class="stat">
        <b id="statFriends">0</b>
        <span>Друзей</span>
      </div>

    </div>

  </div>


  <div class="title">🎁 Ежедневная награда</div>

  <div class="card">

    <div style="color:#8995a6;font-size:13px">
      За ежедневный вход ты получаешь награду.
    </div>

    <div class="reward-box" id="dailyBox"></div>

    <button class="claim-daily" id="dailyButton"
      onclick="claimDaily()">
      🎁 Забрать награду
    </button>

  </div>

</section>


<!-- =========================
     РЕЙТИНГ
========================= -->

<section id="rating" class="page hidden">

  <div class="title">🏆 ТОП-100</div>

  <div class="card">
    Рейтинг подключим к серверной базе.
  </div>

</section>


<!-- =========================
     МАГАЗИН
========================= -->

<section id="shop" class="page hidden">

  <div class="title">🪙 Магазин</div>

  <div class="store">

    <div class="pack">
      <div>
        <div class="pack-coins">200 🪙</div>
        <div class="pack-price">⭐ 15 Stars</div>
      </div>

      <button class="buy"
        onclick="visualBuy(200,15)">
        Купить
      </button>
    </div>


    <div class="pack">
      <div>
        <div class="pack-coins">500 🪙</div>
        <div class="pack-price">⭐ 30 Stars</div>
      </div>

      <button class="buy"
        onclick="visualBuy(500,30)">
        Купить
      </button>
    </div>


    <div class="pack">
      <div>
        <div class="pack-coins">1800 🪙</div>
        <div class="pack-price">⭐ 100 Stars</div>
      </div>

      <button class="buy"
        onclick="visualBuy(1800,100)">
        Купить
      </button>
    </div>

  </div>

</section>


<!-- =========================
     НИЖНЕЕ МЕНЮ
========================= -->

<div class="bottom">

  <button class="active"
    onclick="showPage('home',this)">
    <span>🏠</span>
    Главная
  </button>

  <button onclick="showPage('inventory',this)">
    <span>🎒</span>
    Инвентарь
  </button>

  <button onclick="showPage('upgrade',this)">
    <span>⬆️</span>
    Upgrade
  </button>

  <button onclick="showPage('profile',this)">
    <span>👤</span>
    Профиль
  </button>

  <button onclick="showPage('shop',this)">
    <span>🪙</span>
    Магазин
  </button>

</div>

</div>


<!-- =========================
     РУЛЕТКА КЕЙСА
========================= -->

<div class="case-modal" id="caseModal">

  <div class="case-window">

    <h2 id="caseTitle">
      Открытие кейса
    </h2>

    <div class="roulette">

      <div class="pointer"></div>

      <div class="roulette-track"
        id="rouletteTrack"></div>

    </div>

    <div class="result" id="caseResult">
      Крутим...
    </div>

    <button class="close-case"
      id="closeCaseButton"
      onclick="closeCase()"
      disabled>
      ЗАКРЫТЬ
    </button>

  </div>

</div>


<!-- =========================
     ВЫБОР СКИНОВ
========================= -->

<div class="selector-modal" id="selectorModal">

  <div class="selector-window">

    <div class="selector-title">
      🎒 Выбор скинов
    </div>

    <div class="selector-info">
      Выбери до 3 скинов ОДНОЙ редкости
    </div>

    <div class="selector-grid" id="selectorGrid"></div>

    <button class="selector-close"
      onclick="closeSkinSelector()">
      ГОТОВО
    </button>

  </div>

</div>


<div class="toast" id="toast"></div>


<script src="https://telegram.org/js/telegram-web-app.js"></script>

<script>

/* =========================
   API
========================= */

const API =
"https://oxide-drops-api.maksimvaim56.workers.dev";


/* =========================
   РЕДКОСТИ
========================= */

const RARITIES=[

  {
    name:"Обычный",
    icon:"⬜",
    value:15,
    chance:52,
    className:"common"
  },

  {
    name:"Редкий",
    icon:"🔵",
    value:40,
    chance:17,
    className:"rare"
  },

  {
    name:"Супер редкий",
    icon:"🔷",
    value:60,
    chance:13,
    className:"superrare"
  },

  {
    name:"Эпический",
    icon:"🟣",
    value:85,
    chance:10,
    className:"epic"
  },

  {
    name:"Мифический",
    icon:"🔴",
    value:100,
    chance:6,
    className:"mythic"
  },

  {
    name:"Легендарный",
    icon:"🟡",
    value:125,
    chance:2,
    className:"legendary"
  }

];


/* =========================
   КЕЙСЫ
========================= */

const CASES={

  "Морозный ужас":{
    price:40,
    icon:"❄️"
  },

  "Адское пламя":{
    price:50,
    icon:"🔥"
  },

  "Эпоха современности":{
    price:30,
    icon:"🤖"
  },

  "Оружейный ящик":{
    price:35,
    icon:"🔫"
  }

};


/* =========================
   СОСТОЯНИЕ
========================= */

const state={

  coins:250,

  hp:0,

  casesOpened:0,

  upgrades:0,

  friends:0,

  inventory:[],

  selectedItems:[],

  dailyClaimed:false

};


const ranks=[

  {name:"Новобранец",hp:0},

  {name:"Рядовой",hp:50},

  {name:"Сержант",hp:300},

  {name:"Лудаман",hp:770},

  {name:"Лейтенант",hp:1250},

  {name:"Ветеран",hp:1900},

  {name:"Генерал",hp:2600},

  {name:"ЛЕГЕНДА",hp:3500}

];


const dailyRewards=[
  80,80,80,150,200,220,300
];


let selectedChance=75;
let strength=20;
let holding=false;
let strengthTimer=null;
let caseOpening=false;
let upgradeRunning=false;


/* =========================
   TOAST
========================= */

function toast(text){

  const el=document.getElementById("toast");

  el.textContent=text;

  el.classList.add("show");

  setTimeout(()=>{
    el.classList.remove("show");
  },2200);

}


/* =========================
   СТРАНИЦЫ
========================= */

function showPage(id,button){

  if(caseOpening || upgradeRunning)
    return;

  document.querySelectorAll(".page")
    .forEach(p=>p.classList.add("hidden"));

  document.getElementById(id)
    .classList.remove("hidden");

  document.querySelectorAll(".bottom button")
    .forEach(b=>b.classList.remove("active"));

  button.classList.add("active");

  if(id==="inventory")
    renderInventory();

  if(id==="profile")
    renderProfile();

}


/* =========================
   РАНГ
========================= */

function getRank(){

  let rank=ranks[0];

  for(const r of ranks){

    if(state.hp>=r.hp)
      rank=r;

  }

  return rank;

}


/* =========================
   РЕНДЕР
========================= */

function render(){

  document.getElementById("coins")
    .textContent=
    state.coins.toLocaleString("ru-RU");

  renderInventory();
  renderProfile();
  renderDaily();

}


/* =========================
   DAILY
========================= */

function renderDaily(){

  const box=document.getElementById("dailyBox");

  box.innerHTML="";

  dailyRewards.forEach((reward,index)=>{

    const div=document.createElement("div");

    div.className="day";

    if(index===0 && !state.dailyClaimed)
      div.classList.add("today");

    if(state.dailyClaimed && index===0)
      div.classList.add("claimed");

    div.innerHTML=
      `Д${index+1}<b>${reward}</b>`;

    box.appendChild(div);

  });


  const button=
    document.getElementById("dailyButton");

  if(state.dailyClaimed){

    button.textContent="✅ Награда получена";
    button.disabled=true;

  }else{

    button.textContent=
      `🎁 Забрать ${dailyRewards[0]} 🪙`;

    button.disabled=false;

  }

}


/* =========================
   ПОЛУЧЕНИЕ DAILY
========================= */

function claimDaily(){

  if(state.dailyClaimed){

    toast("Награда уже получена");

    return;

  }


  const reward=dailyRewards[0];

  state.coins+=reward;

  state.dailyClaimed=true;

  render();

  toast(`🎁 Получено ${reward} 🪙`);

}


/* =========================
   ПРОФИЛЬ
========================= */

function renderProfile(){

  const rank=getRank();

  const user=
    window.Telegram?.WebApp?.initDataUnsafe?.user;

  document.getElementById("profileName")
    .textContent=
    user?.first_name || "Игрок";

  document.getElementById("profileRank")
    .textContent=
    rank.name;

  document.getElementById("statOpen")
    .textContent=
    state.casesOpened;

  document.getElementById("statUpgrade")
    .textContent=
    state.upgrades;

  document.getElementById("statFriends")
    .textContent=
    state.friends;


  const next=
    ranks.find(r=>r.hp>state.hp);


  if(next){

    document.getElementById("xpText")
      .textContent=
      `${state.hp} / ${next.hp} HP`;

    const percent=
      ((state.hp-rank.hp)/
      (next.hp-rank.hp))*100;

    document.getElementById("xpBar")
      .style.width=
      Math.max(0,Math.min(100,percent))+"%";

  }else{

    document.getElementById("xpText")
      .textContent=
      `${state.hp} HP • МАКСИМУМ`;

    document.getElementById("xpBar")
      .style.width="100%";

  }

}


/* =========================
   ИНВЕНТАРЬ
========================= */

function renderInventory(){

  const grid=
    document.getElementById("inventoryGrid");


  if(!state.inventory.length){

    grid.innerHTML=`

      <div class="card"
        style="grid-column:1/-1;text-align:center">
        🎒 Инвентарь пуст
      </div>

    `;

    return;

  }


  grid.innerHTML=
  state.inventory.map((item,index)=>`

    <div class="item">

      <div class="item-img">
        ${item.icon}
      </div>

      <div class="item-name ${item.className}">
        ${item.name}
      </div>

      <div class="item-price ${item.className}">
        ${item.value} 🪙
      </div>

      <button class="sell"
        onclick="sellItem(${index})">
        💰 Продать
      </button>

    </div>

  `).join("");

}


/* =========================
   ПРОДАЖА
========================= */

function sellItem(index){

  if(upgradeRunning)
    return;


  const item=state.inventory[index];

  if(!item)return;


  state.coins+=Number(item.value||0);

  state.inventory.splice(index,1);


  state.selectedItems=
    state.selectedItems.filter(
      x=>x!==item
    );


  render();

  toast(`Продано за ${item.value} 🪙`);

}


/* =========================
   ВЫБОР СКИНОВ
========================= */

function openSkinSelector(){

  if(upgradeRunning){

    toast("Upgrade уже выполняется");

    return;

  }


  if(!state.inventory.length){

    toast("Сначала получи скин из кейса");

    return;

  }


  renderSelector();

  document.getElementById("selectorModal")
    .classList.add("show");

}


function closeSkinSelector(){

  document.getElementById("selectorModal")
    .classList.remove("show");

  updateSelectedUI();

}


/* =========================
   SELECTOR
========================= */

function renderSelector(){

  const grid=
    document.getElementById("selectorGrid");

  grid.innerHTML="";


  state.inventory.forEach((item,index)=>{

    const selected=
      state.selectedItems.includes(item);

    const hasSelected=
      state.selectedItems.length>0;

    const sameRarity=
      !hasSelected ||
      item.className===
      state.selectedItems[0].className;


    const div=
      document.createElement("button");

    div.className=
      "selector-item"+
      (selected?" selected":"");

    div.disabled=
      !sameRarity &&
      !selected;


    div.innerHTML=`

      <div class="big">
        ${item.icon}
      </div>

      <b class="${item.className}">
        ${item.name}
      </b>

      <small>
        ${item.value} 🪙
      </small>

    `;


    div.onclick=()=>{

      toggleSelectedItem(item);

    };


    grid.appendChild(div);

  });

}


function toggleSelectedItem(item){

  const index=
    state.selectedItems.indexOf(item);


  if(index!==-1){

    state.selectedItems.splice(index,1);

    renderSelector();

    updateSelectedUI();

    return;

  }


  if(state.selectedItems.length>=3){

    toast("Можно выбрать максимум 3 скина");

    return;

  }


  if(
    state.selectedItems.length>0 &&
    state.selectedItems[0].className!==item.className
  ){

    toast("Можно выбирать только одну редкость");

    return;

  }


  state.selectedItems.push(item);

  renderSelector();

  updateSelectedUI();

}


function updateSelectedUI(){

  const icon=
    document.getElementById("upgradeIcon");

  const name=
    document.getElementById("upgradeName");

  const value=
    document.getElementById("upgradeValue");

  const list=
    document.getElementById("selectedList");


  if(!state.selectedItems.length){

    icon.textContent="⬜";

    name.textContent="Скины не выбраны";

    value.textContent="—";

    list.textContent=
      "Можно выбрать до 3 скинов одной редкости.";

    return;

  }


  const first=
    state.selectedItems[0];


  icon.textContent=
    first.icon;


  name.textContent=
    `${state.selectedItems.length} скин(а) выбрано`;


  const total=
    state.selectedItems.reduce(
      (sum,item)=>
      sum+Number(item.value||0),0
    );


  value.textContent=
    `${total} 🪙 всего`;


  list.textContent=
    state.selectedItems
      .map(item=>item.name)
      .join(" • ");

}


/* =========================
   СЛУЧАЙНАЯ РЕДКОСТЬ
========================= */

function getRandomRarity(){

  const roll=Math.random()*100;

  let current=0;

  for(const rarity of RARITIES){

    current+=rarity.chance;

    if(roll<current)
      return rarity;

  }

  return RARITIES[0];

}


/* =========================
   РУЛЕТКА
========================= */

function createRouletteItems(){

  const result=[];

  for(let i=0;i<70;i++){

    result.push(getRandomRarity());

  }

  return result;

}


/* =========================
   ОТКРЫТИЕ КЕЙСА
========================= */

function openCase(caseName,caseIcon,price){

  if(caseOpening)
    return;


  if(state.coins<price){

    toast("Недостаточно монет");

    return;

  }


  caseOpening=true;

  state.coins-=price;

  state.casesOpened++;

  state.hp+=15;

  render();


  const modal=
    document.getElementById("caseModal");

  const track=
    document.getElementById("rouletteTrack");

  const result=
    document.getElementById("caseResult");

  const close=
    document.getElementById("closeCaseButton");

  document.getElementById("caseTitle")
    .textContent=
    `🎁 ${caseName}`;

  result.textContent="Крутим...";

  close.disabled=true;

  track.innerHTML="";


  const roulette=createRouletteItems();


  roulette.forEach(rarity=>{

    const item=
      document.createElement("div");

    item.className="roulette-item";

    item.innerHTML=`

      <div class="icon">
        ${rarity.icon}
      </div>

      <span class="${rarity.className}">
        ${rarity.name}
      </span>

    `;

    track.appendChild(item);

  });


  modal.classList.add("show");

  track.style.transition="none";

  track.style.transform="translateX(0)";

  void track.offsetWidth;


  const winningIndex=
    45+Math.floor(Math.random()*6);

  const itemWidth=103;

  const centerOffset=
    (track.parentElement.clientWidth/2)
    -(winningIndex*itemWidth)-47;

  const randomOffset=
    Math.random()*12-6;

  const finalX=
    centerOffset+randomOffset;


  track.style.transition=
    "transform 8.5s cubic-bezier(.08,.75,.12,1)";

  track.style.transform=
    `translateX(${finalX}px)`;


  setTimeout(()=>{

    const rarity=
      roulette[winningIndex];


    const item={

      name:`${rarity.name} скин`,

      icon:rarity.icon,

      value:rarity.value,

      className:rarity.className

    };


    state.inventory.push(item);


    result.innerHTML=
      `🎉 Выпал: <span class="${rarity.className}">
      ${item.name}
      </span>`;


    close.disabled=false;

    render();

  },8700);

}


/* =========================
   ОРУЖЕЙНЫЙ ЯЩИК
========================= */

function openWeaponCase(){

  openCase(
    "Оружейный ящик",
    "🔫",
    35
  );

}


/* =========================
   ЗАКРЫТИЕ
========================= */

function closeCase(){

  const close=
    document.getElementById("closeCaseButton");


  if(close.disabled)
    return;


  document.getElementById("caseModal")
    .classList.remove("show");

  caseOpening=false;

}


/* =========================
   UPGRADE ШАНС
========================= */

function selectChance(chance,button){

  if(upgradeRunning)
    return;


  selectedChance=chance;


  document.querySelectorAll(".chance")
    .forEach(x=>
      x.classList.remove("selected")
    );


  button.classList.add("selected");


  document.getElementById("wheelText")
    .textContent=
    chance+"%";


  const degrees=
    chance===75
      ?270
      :chance===50
      ?180
      :118.8;


  const color=
    chance===75
      ?" #5ee68a"
      :chance===50
      ?" #ffd84d"
      :" #ff6464";


  document.getElementById("wheel")
    .style.background=
    `conic-gradient(
      ${color} 0deg ${degrees}deg,
      #252c36 ${degrees}deg 360deg
    )`;

}


/* =========================
   НАБОР СИЛЫ
========================= */

function startStrength(){

  if(upgradeRunning)
    return;


  if(!state.selectedItems.length){

    toast("Сначала выбери скины");

    return;

  }


  if(state.coins<10){

    toast("Недостаточно монет");

    return;

  }


  if(holding)
    return;


  holding=true;

  strength=20;


  document.getElementById("strength")
    .textContent=strength;


  const button=
    document.getElementById("holdButton");

  button.classList.add("active");


  strengthTimer=
    setInterval(()=>{

      if(!holding)
        return;

      strength+=20;

      if(strength>=100){

        strength=100;

        clearInterval(strengthTimer);

      }

      document.getElementById("strength")
        .textContent=strength;

    },500);

}


/* =========================
   ОТПУСКАНИЕ
========================= */

function stopStrength(){

  if(!holding)
    return;


  holding=false;

  clearInterval(strengthTimer);

  strengthTimer=null;


  document.getElementById("holdButton")
    .classList.remove("active");


  startUpgrade();

}


/* =========================
   UPGRADE
========================= */

function startUpgrade(){

  if(upgradeRunning)
    return;


  if(!state.selectedItems.length){

    toast("Выбери скины");

    return;

  }


  if(state.coins<10){

    toast("Недостаточно монет");

    return;

  }


  upgradeRunning=true;


  const button=
    document.getElementById("holdButton");


  button.disabled=true;


  state.coins-=10;

  state.hp+=20;

  state.upgrades++;


  render();


  const wheel=
    document.getElementById("wheel");


  wheel.style.animation="none";

  void wheel.offsetWidth;


  const rotations=
    Math.max(
      3,
      Math.floor(strength/10)
    );


  const duration=
    2500+rotations*350;


  wheel.style.animation=
    `wheelSpin ${duration}ms cubic-bezier(.12,.72,.16,1)`;


  setTimeout(()=>{

    const success=
      Math.random()*100<selectedChance;


    if(success){

      upgradeSelectedItems(true);

      state.hp+=10;

      toast(
        `✅ Успех! Получено улучшение на ${getUpgradeSteps()} ступ.`
      );

    }else{

      upgradeSelectedItems(false);

      toast(
        "❌ Проигрыш! Скин ухудшен."
      );

    }


    upgradeRunning=false;

    button.disabled=false;

    strength=20;

    document.getElementById("strength")
      .textContent="20";


    state.selectedItems=[];

    updateSelectedUI();

    render();

  },duration+100);

}


/* =========================
   СТУПЕНИ UPGRADE
========================= */

function getUpgradeSteps(){

  if(selectedChance===75)
    return 1;

  if(selectedChance===50)
    return 2;

  return 3;

}


/* =========================
   ПРИМЕНЕНИЕ UPGRADE
========================= */

function upgradeSelectedItems(success){

  const selected=
    [...state.selectedItems];


  if(success){

    const steps=getUpgradeSteps();


    selected.forEach(item=>{

      const index=
        RARITIES.findIndex(
          r=>r.className===item.className
        );


      const newIndex=
        Math.min(
          RARITIES.length-1,
          index+steps
        );


      const rarity=
        RARITIES[newIndex];


      item.name=
        `${rarity.name} скин`;

      item.icon=
        rarity.icon;

      item.value=
        rarity.value;

      item.className=
        rarity.className;

    });


  }else{

    selected.forEach(item=>{

      const index=
        RARITIES.findIndex(
          r=>r.className===item.className
        );


      const down=
        Math.random()<.5
          ?1
          :2;


      const newIndex=
        index-down;


      if(newIndex<0){

        const inventoryIndex=
          state.inventory.indexOf(item);

        if(inventoryIndex!==-1)
          state.inventory.splice(
            inventoryIndex,1
          );

        return;

      }


      const rarity=
        RARITIES[newIndex];


      item.name=
        `${rarity.name} скин`;

      item.icon=
        rarity.icon;

      item.value=
        rarity.value;

      item.className=
        rarity.className;

    });

  }

}


/* =========================
   МАГАЗИН
========================= */

function visualBuy(coins,stars){

  toast(
    `${coins} 🪙 за ⭐ ${stars} — платежи пока отключены`
  );

}


/* =========================
   TELEGRAM
========================= */

function initTelegram(){

  if(window.Telegram?.WebApp){

    Telegram.WebApp.ready();

    Telegram.WebApp.expand();

  }

}


/* =========================
   TOUCH
========================= */

const holdButton=
  document.getElementById("holdButton");


holdButton.addEventListener(
  "pointerdown",
  e=>{

    e.preventDefault();

    startStrength();

  }
);


holdButton.addEventListener(
  "pointerup",
  e=>{

    e.preventDefault();

    stopStrength();

  }
);


holdButton.addEventListener(
  "pointercancel",
  stopStrength
);


holdButton.addEventListener(
  "pointerleave",
  ()=>{

    if(holding)
      stopStrength();

  }
);


/* =========================
   ЗАПУСК
========================= */

function init(){

  initTelegram();

  /*
    Ежедневный подарок
    автоматически доступен
    сразу после входа.
  */

  render();

}


init();

</script>

</body>
</html>
